{
  "name": "react-context-feladat1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n API,REACT -c blue,green \"npm:api\" \"npm:dev\"",
    "api": "json-server --watch db.json --port 3001",
    "dev": "vite --open",
    "build": "vite build",
    "reset": "node -e \"require('fs').copyFileSync('db.eredeti.json','db.json')\""
  },
  "dependencies": {
    "concurrently": "^9.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "json-server": "0.17.4",
    "vite": "^5.4.11",
    "concurrently": "^9.2.4"
  }
}